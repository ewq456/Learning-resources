#!/bin/bash

# 默认配置 - 根据要求默认使用 ARM + release
DEFAULT_ARCH="arm"
DEFAULT_ARM_QMAKE_PATH="/root/qtInstaller/sysroots/armv7ahf-neon-linux-gnueabi/root/qtInstaller/qt-everywhere-opensource-src-5.7.1/qtbase/qt5.7.1/bin/qmake"
DEFAULT_X86_QMAKE_PATH="/opt/Qt5.9.4/5.9.4/gcc_64/bin/qmake"
DEFAULT_ARM_SPEC="linux-arm-gnueabi-g++"
DEFAULT_X86_SPEC="linux-g++"
DEFAULT_PROJECT_PATH="./*.pro"
DEFAULT_BUILD_MODE="release"

# 显示帮助信息
show_help() {
    echo "用法: $0 [选项]"
    echo "选项:"
    echo "  -p, --project <路径>    指定Qt项目文件路径 (默认: $DEFAULT_PROJECT_PATH)"
    echo "  -q, --qmake <路径>      指定qmake路径 (默认: 根据架构自动选择)"
    echo "  -s, --spec <spec>       指定平台spec (默认: 根据架构自动选择)"
    echo "  -m, --mode <模式>       指定构建模式: debug 或 release (默认: $DEFAULT_BUILD_MODE)"
    echo "  -a, --arch <架构>       指定目标架构: x86_64 或 arm (默认: $DEFAULT_ARCH)"
    echo "  -c, --clean             清理构建目录"
    echo "  -h, --help              显示此帮助信息"
    echo ""
    echo "当前默认架构: $DEFAULT_ARCH"
    echo "ARM默认qmake路径: $DEFAULT_ARM_QMAKE_PATH"
    echo "x86_64默认qmake路径: $DEFAULT_X86_QMAKE_PATH"
    echo ""
    echo "示例:"
    echo "  $0 -p /path/to/project.pro -m release"
    echo "  $0 --qmake /usr/bin/qmake --spec linux-g++"
    echo "  $0 --arch x86_64  # 指定x86_64架构"
    echo "  $0 --arch arm     # 指定ARM架构"
    echo "  $0 --clean        # 清理构建目录"
}

# 解析命令行参数
parse_arguments() {
    CLEAN=false
    USER_SET_ARCH=false
    USER_SET_SPEC=false
    USER_SET_QMAKE=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -p|--project)
                PROJECT_PATH="$2"
                shift
                shift
                ;;
            -q|--qmake)
                QMAKE_PATH="$2"
                USER_SET_QMAKE=true
                shift
                shift
                ;;
            -s|--spec)
                QMAKE_SPEC="$2"
                USER_SET_SPEC=true
                shift
                shift
                ;;
            -m|--mode)
                BUILD_MODE="$2"
                shift
                shift
                ;;
            -a|--arch)
                ARCH="$2"
                USER_SET_ARCH=true
                shift
                shift
                ;;
            -c|--clean)
                CLEAN=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                echo "未知选项: $1"
                show_help
                exit 1
                ;;
        esac
    done
}

# 根据架构设置qmake和spec的默认值
set_arch_defaults() {
    if [[ "$ARCH" == "x86_64" ]]; then
        if [[ "$USER_SET_QMAKE" == "false" ]]; then
            QMAKE_PATH=${QMAKE_PATH:-"$DEFAULT_X86_QMAKE_PATH"}
        fi
        if [[ "$USER_SET_SPEC" == "false" ]]; then
            QMAKE_SPEC=${QMAKE_SPEC:-"$DEFAULT_X86_SPEC"}
        fi
    else
        # 默认为arm架构
        ARCH="arm"
        if [[ "$USER_SET_QMAKE" == "false" ]]; then
            QMAKE_PATH=${QMAKE_PATH:-"$DEFAULT_ARM_QMAKE_PATH"}
        fi
        if [[ "$USER_SET_SPEC" == "false" ]]; then
            QMAKE_SPEC=${QMAKE_SPEC:-"$DEFAULT_ARM_SPEC"}
        fi
    fi
}

# 检查qmake是否存在，如果找不到则尝试自动查找
check_qmake() {
    if ! command -v "$QMAKE_PATH" &> /dev/null; then
        echo "警告: 找不到指定的qmake: $QMAKE_PATH"
        echo "正在尝试自动查找可用的qmake..."
        
        # 尝试在常见位置查找qmake
        local possible_paths=(
            "/usr/bin/qmake"
            "/usr/local/bin/qmake"
            "/opt/qt*/bin/qmake"
            "$HOME/qt*/bin/qmake"
            "/opt/Qt*/**/bin/qmake"
        )
        
        for path_pattern in "${possible_paths[@]}"; do
            # 使用通配符扩展查找匹配的路径
            for expanded_path in $path_pattern; do
                if [[ -x "$expanded_path" && -f "$expanded_path" ]]; then
                    QMAKE_PATH="$expanded_path"
                    echo "找到并使用qmake: $QMAKE_PATH"
                    
                    # 检测qmake对应的架构
                    detect_qmake_arch
                    return 0
                fi
            done
        done
        
        # 如果上面没找到，尝试使用which命令查找
        local which_qmake=$(which qmake 2>/dev/null)
        if [[ -n "$which_qmake" && -x "$which_qmake" ]]; then
            QMAKE_PATH="$which_qmake"
            echo "找到并使用qmake: $QMAKE_PATH"
            
            # 检测qmake对应的架构
            detect_qmake_arch
            return 0
        fi
        
        echo "错误: 无法找到可用的qmake"
        echo "请使用 -q 参数指定正确的qmake路径"
        return 1
    fi
    
    # 检测qmake对应的架构
    detect_qmake_arch
    
    echo "使用qmake: $QMAKE_PATH"
    return 0
}

# 检测qmake对应的架构
detect_qmake_arch() {
    # 从qmake路径推断架构
    if echo "$QMAKE_PATH" | grep -q "gcc_64\|x86_64"; then
        DETECTED_ARCH="x86_64"
        DETECTED_SPEC="$DEFAULT_X86_SPEC"
    elif echo "$QMAKE_PATH" | grep -q "arm"; then
        DETECTED_ARCH="arm"
        DETECTED_SPEC="$DEFAULT_ARM_SPEC"
    else
        # 如果无法从路径推断，尝试运行qmake查询
        local qt_arch=$("$QMAKE_PATH" -query QT_ARCH 2>/dev/null || echo "")
        if [[ -n "$qt_arch" ]]; then
            DETECTED_ARCH="$qt_arch"
            if [[ "$qt_arch" == "x86_64" ]]; then
                DETECTED_SPEC="$DEFAULT_X86_SPEC"
            else
                DETECTED_SPEC="$DEFAULT_ARM_SPEC"
            fi
        else
            DETECTED_ARCH="unknown"
            DETECTED_SPEC="unknown"
        fi
    fi
    
    # 如果用户没有明确指定架构，使用检测到的架构
    if [[ "$USER_SET_ARCH" == "false" && "$DETECTED_ARCH" != "unknown" ]]; then
        echo "检测到qmake对应架构: $DETECTED_ARCH，自动切换"
        ARCH="$DETECTED_ARCH"
        
        # 如果用户没有指定spec，也更新spec
        if [[ "$USER_SET_SPEC" == "false" && "$DETECTED_SPEC" != "unknown" ]]; then
            QMAKE_SPEC="$DETECTED_SPEC"
            echo "自动设置spec为: $QMAKE_SPEC"
        fi
    fi
    
    # 检查架构一致性
    if [[ "$USER_SET_ARCH" == "true" && "$ARCH" != "$DETECTED_ARCH" && "$DETECTED_ARCH" != "unknown" ]]; then
        echo "警告: 指定的架构($ARCH)与qmake对应的架构($DETECTED_ARCH)不一致"
        echo "这可能导致编译错误，请确保使用正确的qmake和spec"
        read -p "是否继续? (y/N): " confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
            echo "操作已取消"
            exit 1
        fi
    fi
}

# 设置构建目录和参数
setup_build() {
    local project_dir=$(dirname "$PROJECT_PATH")
    local project_name=$(basename "$PROJECT_PATH" .pro)
    
    BUILD_DIR="$project_dir/build-${project_name}-${ARCH}-${BUILD_MODE}"
    echo "构建目录: $BUILD_DIR"
    echo "目标架构: $ARCH"
    
    # 设置qmake参数
    if [[ "$BUILD_MODE" == "debug" ]]; then
        QMAKE_ARGS="CONFIG+=debug CONFIG+=qml_debug"
    else
        QMAKE_ARGS="CONFIG+=release"
    fi
    
    # 添加spec参数
    if [[ -n "$QMAKE_SPEC" ]]; then
        QMAKE_ARGS+=" -spec $QMAKE_SPEC"
    fi
}

# 清理构建目录
clean_build() {
    local project_dir=$(dirname "$PROJECT_PATH")
    local project_name=$(basename "$PROJECT_PATH" .pro)
    
    # 清理所有可能的构建目录
    local debug_build_dir_x86="$project_dir/build-${project_name}-x86_64-debug"
    local release_build_dir_x86="$project_dir/build-${project_name}-x86_64-release"
    local debug_build_dir_arm="$project_dir/build-${project_name}-arm-debug"
    local release_build_dir_arm="$project_dir/build-${project_name}-arm-release"
    
    echo "正在清理构建目录..."
    
    # 清理x86构建目录
    if [[ -d "$debug_build_dir_x86" ]]; then
        echo "删除: $debug_build_dir_x86"
        rm -rf "$debug_build_dir_x86"
    fi
    
    if [[ -d "$release_build_dir_x86" ]]; then
        echo "删除: $release_build_dir_x86"
        rm -rf "$release_build_dir_x86"
    fi
    
    # 清理ARM构建目录
    if [[ -d "$debug_build_dir_arm" ]]; then
        echo "删除: $debug_build_dir_arm"
        rm -rf "$debug_build_dir_arm"
    fi
    
    if [[ -d "$release_build_dir_arm" ]]; then
        echo "删除: $release_build_dir_arm"
        rm -rf "$release_build_dir_arm"
    fi
    
    # 如果没有找到任何构建目录
    if [[ ! -d "$debug_build_dir_x86" && ! -d "$release_build_dir_x86" && 
          ! -d "$debug_build_dir_arm" && ! -d "$release_build_dir_arm" ]]; then
        echo "清理完成"
    fi
}

# 执行构建过程
perform_build() {
    echo "开始构建..."
    echo "模式: $BUILD_MODE"
    echo "架构: $ARCH"
    echo "Spec: $QMAKE_SPEC"
    
    # 创建构建目录
    mkdir -p "$BUILD_DIR"
    if [[ $? -ne 0 ]]; then
        echo "错误: 无法创建构建目录 $BUILD_DIR"
        return 1
    fi
    
    # 进入构建目录
    cd "$BUILD_DIR" || return 1
    
    # 运行qmake
    echo "运行qmake..."
    echo "命令: $QMAKE_PATH $QMAKE_ARGS $PROJECT_PATH"
    "$QMAKE_PATH" $QMAKE_ARGS "$PROJECT_PATH"
    if [[ $? -ne 0 ]]; then
        echo "错误: qmake执行失败"
        
        # 检查是否是架构不匹配导致的错误
        if [[ "$ARCH" == "arm" && "$DETECTED_ARCH" == "x86_64" ]]; then
            echo "检测到可能是架构不匹配问题"
            echo "您正在尝试使用x86_64的qmake编译ARM架构的项目"
            echo "请确保:"
            echo "1. 已安装ARM交叉编译工具链"
            echo "2. 使用正确的qmake路径: $DEFAULT_ARM_QMAKE_PATH"
            echo "3. 或者使用 -a x86_64 参数重新编译为x86_64架构"
        fi
        
        return 1
    fi
    
    # 运行make
    echo "运行make..."
    
    local make_cmd="make"
    
    if command -v nproc &> /dev/null; then
        # 使用所有可用的CPU核心
        eval "$make_cmd -j$(nproc)"
    else
        eval "$make_cmd"
    fi
    
    if [[ $? -ne 0 ]]; then
        echo "错误: make执行失败"
        return 1
    fi
    
    echo "构建成功完成!"
    echo "输出目录: $BUILD_DIR"
    return 0
}

# 查找项目文件
find_project_file() {
    if [[ -f "$PROJECT_PATH" ]]; then
        echo "使用项目文件: $PROJECT_PATH"
        # 获取绝对路径
        PROJECT_PATH=$(readlink -f "$PROJECT_PATH")
        echo "绝对路径: $PROJECT_PATH"
        return 0
    fi
    
    # 如果路径包含通配符，尝试扩展
    if [[ "$PROJECT_PATH" == *"*"* ]]; then
        local files=( $PROJECT_PATH )
        if [[ ${#files[@]} -eq 1 && -f "${files[0]}" ]]; then
            PROJECT_PATH="${files[0]}"
            echo "找到项目文件: $PROJECT_PATH"
            # 获取绝对路径
            PROJECT_PATH=$(readlink -f "$PROJECT_PATH")
            echo "绝对路径: $PROJECT_PATH"
            return 0
        elif [[ ${#files[@]} -gt 1 ]]; then
            echo "找到多个项目文件:"
            for i in "${!files[@]}"; do
                echo "  $((i+1))). ${files[i]}"
            done
            read -p "请选择要编译的项目文件编号: " choice
            if [[ $choice -gt 0 && $choice -le ${#files[@]} ]]; then
                PROJECT_PATH="${files[$((choice-1))]}"
                echo "选择项目文件: $PROJECT_PATH"
                # 获取绝对路径
                PROJECT_PATH=$(readlink -f "$PROJECT_PATH")
                echo "绝对路径: $PROJECT_PATH"
                return 0
            else
                echo "无效的选择"
                return 1
            fi
        fi
    fi
    
    echo "错误: 找不到项目文件: $PROJECT_PATH"
    return 1
}

# 主函数
main() {
    # 设置默认值
    ARCH="$DEFAULT_ARCH"
    PROJECT_PATH="$DEFAULT_PROJECT_PATH"
    BUILD_MODE="$DEFAULT_BUILD_MODE"
    USER_SET_ARCH=false
    USER_SET_SPEC=false
    USER_SET_QMAKE=false
    
    # 解析参数
    parse_arguments "$@"
    
    # 设置架构相关的默认值
    set_arch_defaults
    
    # 如果只需要清理，则执行清理并退出
    if [[ "$CLEAN" == "true" ]]; then
        # 需要先找到项目文件才能确定构建目录
        if find_project_file; then
            clean_build
        else
            echo "错误: 无法确定要清理的项目"
            exit 1
        fi
        # 如果只有clean选项，清理后退出
        if [[ $# -eq 1 ]]; then
            exit 0
        fi
        # 如果有其他选项，继续执行构建
    fi
    
    # 验证构建模式
    if [[ "$BUILD_MODE" != "debug" && "$BUILD_MODE" != "release" ]]; then
        echo "错误: 无效的构建模式 '$BUILD_MODE'，必须是 'debug' 或 'release'"
        exit 1
    fi
    
    # 验证架构
    if [[ "$ARCH" != "x86_64" && "$ARCH" != "arm" ]]; then
        echo "错误: 无效的架构 '$ARCH'，必须是 'x86_64' 或 'arm'"
        exit 1
    fi
    
    # 查找项目文件
    if ! find_project_file; then
        exit 1
    fi
    
    # 检查qmake
    if ! check_qmake; then
        exit 1
    fi
    
    # 设置构建环境
    setup_build
    
    # 执行构建
    if perform_build; then
        exit 0
    else
        exit 1
    fi
}

# 运行主函数
main "$@"
